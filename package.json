{
  "name": "grupo-adriano-cobuccio-challanger",
  "private": true,
  "description": "Desafio técnico — carteira financeira do Grupo Adriano Cobuccio",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm test:e2e:api && pnpm test:e2e:web",
    "test:e2e:api": "pnpm --filter api test:e2e",
    "test:e2e:web": "pnpm --filter web test:e2e",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "db:migrate": "pnpm --filter api db:migrate",
    "compose:up": "docker compose up --build -d",
    "compose:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.13.0"
}
