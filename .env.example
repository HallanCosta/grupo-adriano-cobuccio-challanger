# Copie este arquivo para .env e ajuste se necessário.
# Valores abaixo são apenas de desenvolvimento local — não use em produção.

# Postgres
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_DB=wallet
POSTGRES_PORT=5432

# API (Nest.js)
API_PORT=3001
NODE_ENV=development
LOG_LEVEL=info
# No Docker Compose o host do banco é "postgres"; em execução local use "localhost".
DATABASE_URL=postgresql://wallet:wallet@localhost:5432/wallet

# Web (Next.js)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
